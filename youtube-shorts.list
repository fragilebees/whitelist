# YouTube Shorts ruleset for Clash Verge
# behavior: classical | format: text
# YouTube Shorts uses the same core YouTube infrastructure but with specific
# CDN subdomains and API endpoints. Video streams carry the `ctier=SH` query
# parameter on *.googlevideo.com. Full blocking requires covering the API
# endpoints below in addition to the main youtube.com domain.

# --- Shorts UI / API endpoints ---
# Main watch page (youtube.com/shorts/*)
DOMAIN-SUFFIX,youtube.com
DOMAIN-SUFFIX,m.youtube.com

# Shorts-specific InnerTube API endpoints
DOMAIN-KEYWORD,youtubei
DOMAIN-SUFFIX,youtubei.googleapis.com
DOMAIN-SUFFIX,youtubeembeddedplayer.googleapis.com
DOMAIN-SUFFIX,youtube.googleapis.com

# --- Video CDN (streams tagged ctier=SH) ---
# Shorts video segments are served from *.googlevideo.com subdomains.
# Specific wildcards used by Shorts players:
DOMAIN-SUFFIX,googlevideo.com
DOMAIN-SUFFIX,rr1---sn-googlevideo.com
DOMAIN-SUFFIX,rr2---sn-googlevideo.com
DOMAIN-SUFFIX,rr3---sn-googlevideo.com
DOMAIN-SUFFIX,rr4---sn-googlevideo.com
DOMAIN-SUFFIX,rr5---sn-googlevideo.com

# --- Thumbnails / metadata ---
DOMAIN-SUFFIX,ytimg.com
DOMAIN-SUFFIX,yt3.ggpht.com
DOMAIN-SUFFIX,ggpht.com

# --- Shorts redirect / shortlink ---
DOMAIN-SUFFIX,youtu.be

# --- IP ranges (Google Video / YouTube CDN, AS15169) ---
# These ranges are used for Shorts video delivery via googlevideo.com CDN.
IP-CIDR,173.194.0.0/16
IP-CIDR,74.125.0.0/16
IP-CIDR,64.233.160.0/19
IP-CIDR,66.102.0.0/20
IP-CIDR,66.249.64.0/19
IP-CIDR,72.14.192.0/18
IP-CIDR,209.85.128.0/17
IP-CIDR,216.58.192.0/19
IP-CIDR,216.239.32.0/19
IP-CIDR,108.177.8.0/21
IP-CIDR,104.237.160.0/19
IP-CIDR,35.191.0.0/16
IP-CIDR,130.211.0.0/22
# Ranges specifically observed for YouTube/Shorts streams (AS15169 blocks)
IP-CIDR,172.217.0.0/16
IP-CIDR,142.250.0.0/15
IP-CIDR,34.64.0.0/10
IP-CIDR6,2404:6800::/32
IP-CIDR6,2607:f8b0::/32
IP-CIDR6,2620:11a:a000::/40
IP-CIDR6,2620:120:e000::/40
IP-CIDR6,2a00:1450::/32
